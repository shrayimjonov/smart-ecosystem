<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026_08_19_add_source_to_company" author="ned.umarov">
        <preConditions
                onFail="MARK_RAN"
                onFailMessage="Column 'source' already exists in table 'public.company'"
                onError="HALT"
                onErrorMessage="Error while checking preconditions for 'public.company.source'">
            <not>
                <columnExists
                        tableName="company"
                        columnName="source"/>
            </not>
        </preConditions>

        <addColumn tableName="company">
            <column name="source" type="varchar(255)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>