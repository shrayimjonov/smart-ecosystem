<databaseChangeLog xmlns='http://www.liquibase.org/xml/ns/dbchangelog'
                   xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
                   xsi:schemaLocation='http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-2.0.xsd'>
    <changeSet author="xayrullayev" id="aggregation_add_utilisation_id" failOnError="true">
        <preConditions onFail="MARK_RAN" onSqlOutput="FAIL">
            <not>
                <columnExists tableName="aggregation" columnName="utilisation_id"/>
                <columnExists tableName="aggregation" columnName="utilisation_time"/>
            </not>
        </preConditions>
        <addColumn tableName="aggregation">
            <column name="utilisation_id" type="varchar(255)"/>
            <column name="utilisation_time" type="timestamp"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
