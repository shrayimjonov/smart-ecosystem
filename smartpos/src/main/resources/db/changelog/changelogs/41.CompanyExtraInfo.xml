<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">
    <changeSet id="create-company-extra-infos" author="Bahodir Hasanov">
        <createTable tableName="company_extra_infos">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="excise_enabled" type="BOOLEAN">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>
    <changeSet id="company extra info marking check column added" author="Sunnatillo Sharipov">
        <addColumn tableName="company_extra_infos">
            <column name="marking_check_enabled" type="boolean" defaultValue="false"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
