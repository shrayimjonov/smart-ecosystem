<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">
    <changeSet id="fashion stock adjustment item" author="Sunnatillo Sharipov">
        <createTable tableName="fashion_stock_adjustment_item">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="created_at" type="timestamp" defaultValue="now()"/>
            <column name="created_by_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="company_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="product_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="branch_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="city_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="product_item_id" type="bigint"/>
            <column name="unit_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="qty" type="numeric(25, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
