<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">
    <changeSet id="insert TERMINAL_CASHIER role" author="Sunnatillo Sharipov">
        <insert tableName="authority">
            <column name="name">ROLE_TERMINAL_CASHIER</column>
        </insert>
    </changeSet>
    <changeSet id="remove terminal cashier role" author="Sunnatillo Sharipov">
        <update tableName="user_authority">
            <column name="authority_name">ROLE_CASHIER</column>
            <where>authority_name='ROLE_TERMINAL_CASHIER'</where>
        </update>
        <delete tableName="authority">
            <where>name='ROLE_TERMINAL_CASHIER'</where>
        </delete>
    </changeSet>
</databaseChangeLog>
