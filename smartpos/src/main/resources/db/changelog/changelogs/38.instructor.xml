<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">
    <changeSet id="create instructor table" author="Nayimov Og'abek">
        <createTable tableName="instructor">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="file_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="varchar">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar"/>
            <column name="created_by" type="varchar(50)"/>
            <column name="created_date" type="timestamp"/>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="timestamp"/>
            <column name="links" type="jsonb"/>
        </createTable>
    </changeSet>
    <changeSet id="imageId added in instructor table" author="Nayimov Og'abek">
        <addColumn tableName="instructor">
            <column name="image_id" type="bigint"/>
        </addColumn>
    </changeSet>
    <changeSet id="parentCode added in instructor table" author="Nayimov Og'abek">
        <addColumn tableName="instructor">
            <column name="parent_code" type="varchar(50)" defaultValue="COMMON">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>
